# Supabase browser client (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Keep the existing variable name for app compatibility, but use a current
# publishable key here. Never expose a secret/service-role key to Vite.
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Backend API
VITE_DEVELOPMENT_BACKEND_URL=http://localhost:8080
VITE_PRODUCTION_BACKEND_URL=https://YOUR_BACKEND_HOST

# Use a subpath such as /LOMAR/ only when the site is hosted below a domain root.
VITE_BASE_PATH=/

# Local Supabase social providers (server-side only; never prefix with VITE_)
# Provider callback: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_APP_ID
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_APP_SECRET
