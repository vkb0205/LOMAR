# Vertex AI Nano Banana / Gemini image model settings
# Copy this file to .env and fill in your values

# Google Cloud Vertex AI configuration
# Use Vertex AI with authenticated credentials (recommended for production)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
NANO_BANANA_MODEL=gemini-3.1-flash-image

# Optional fallback when GOOGLE_GENAI_USE_VERTEXAI=false
# Only needed if using API key mode instead of Vertex AI
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Backend server settings
API_HOST=0.0.0.0
API_PORT=3003

# For local development - used by frontend to connect to backend
LOMAR_API_URL=http://localhost:3003

# CORS allowed origins (comma-separated for production)
# Set to your GitHub Pages URL in production, e.g.:
# ALLOWED_ORIGINS=https://your-username.github.io
ALLOWED_ORIGINS=*